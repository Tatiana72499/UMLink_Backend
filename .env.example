# Copia estos valores como variables de entorno locales. Nunca subas un archivo .env real.
DB_URL=jdbc:postgresql://localhost:5432/uml_collab
DB_USERNAME=postgres
DB_PASSWORD=postgres
PORT=8080
# Genera una clave aleatoria de al menos 32 caracteres para desarrollo.
JWT_SECRET=replace-with-a-local-secret-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=120
